rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function couplePath(coupleId) {
      return /databases/$(database)/documents/couples/$(coupleId);
    }

    function coupleData(coupleId) {
      return get(couplePath(coupleId)).data;
    }

    function signupOpen() {
      return get(/databases/$(database)/documents/config/app).data.signupEnabled == true;
    }

    function isCoupleMember(coupleId) {
      return isSignedIn() && request.auth.uid in coupleData(coupleId).members;
    }

    function isCreatingOwnCouple() {
      return isSignedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.auth.uid in request.resource.data.members
        && request.resource.data.anniversary is timestamp
        && request.resource.data.createdAt is timestamp;
    }

    function isPairJoinUpdate(coupleId) {
      let currentMembers = coupleData(coupleId).members;
      let nextMembers = request.resource.data.members;

      return isSignedIn()
        && currentMembers is list
        && nextMembers is list
        && currentMembers.size() == 1
        && nextMembers.size() == 2
        && !(request.auth.uid in currentMembers)
        && request.auth.uid in nextMembers
        && currentMembers[0] in nextMembers
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);
    }

    function currentFcmTokens(coupleId) {
      return resource.data.fcmTokens is map ? resource.data.fcmTokens : {};
    }

    function nextFcmTokens() {
      return request.resource.data.fcmTokens is map ? request.resource.data.fcmTokens : {};
    }

    function isOwnFcmTokenUpdate(coupleId) {
      return isCoupleMember(coupleId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens'])
        && nextFcmTokens().diff(currentFcmTokens(coupleId)).affectedKeys().hasOnly([request.auth.uid]);
    }

    function bucketOpenToDone() {
      return resource.data.status == 'open'
        && request.resource.data.status == 'done'
        && request.resource.data.completedBy == request.auth.uid
        && request.resource.data.coverThumbUrl is string
        && request.resource.data.title == resource.data.title
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.deleteVotes == resource.data.deleteVotes;
    }

    function bucketTitleEdit() {
      return resource.data.status == 'open'
        && request.resource.data.status == 'open'
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title']);
    }

    function bucketVoteToggle() {
      return resource.data.status == 'done'
        && request.resource.data.deleteVotes is map
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleteVotes'])
        && request.resource.data.deleteVotes.diff(resource.data.deleteVotes).addedKeys().hasOnly([request.auth.uid])
        && request.resource.data.deleteVotes.diff(resource.data.deleteVotes).changedKeys().size() == 0;
    }

    function bucketCoverThumbsUpdate() {
      return resource.data.status == 'done'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['coverThumbUrls', 'coverThumbUrl', 'completedDate']);
    }

    function bucketAllVotedDelete(coupleId) {
      let memberList = coupleData(coupleId).members;
      let votes = resource.data.deleteVotes;
      return memberList.size() == 2
        && (memberList[0] in votes) && votes[memberList[0]] == true
        && (memberList[1] in votes) && votes[memberList[1]] == true;
    }

    match /config/app {
      allow read: if true;
      allow write: if false;
    }

    match /pairingCodes/{code} {
      allow read: if isSignedIn();
      allow create: if signupOpen()
        && isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.coupleId is string
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /couples/{coupleId} {
      allow create: if signupOpen() && isCreatingOwnCouple();
      allow read, delete: if isCoupleMember(coupleId);
      allow update: if isOwnFcmTokenUpdate(coupleId)
        || (signupOpen() && isPairJoinUpdate(coupleId));

      match /events/{eventId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      match /moods/{moodId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      match /ddays/{ddayId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      match /bucket/{itemId} {
        allow read: if isCoupleMember(coupleId);

        allow create: if isCoupleMember(coupleId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'open'
          && !('coverThumbUrl' in request.resource.data)
          && request.resource.data.deleteVotes is map
          && request.resource.data.deleteVotes.size() == 0;

        allow update: if isCoupleMember(coupleId)
          && (bucketOpenToDone() || bucketTitleEdit() || bucketVoteToggle() || bucketCoverThumbsUpdate());

        allow delete: if isCoupleMember(coupleId)
          && (
            (resource.data.status == 'open' && resource.data.createdBy == request.auth.uid)
            || (resource.data.status == 'done' && bucketAllVotedDelete(coupleId))
          );

        match /photos/{photoId} {
          allow read: if isCoupleMember(coupleId);
          allow create: if isCoupleMember(coupleId)
            && request.resource.data.uploadedBy == request.auth.uid;
          allow update: if false;
          allow delete: if isCoupleMember(coupleId);
        }
      }
    }
  }
}
