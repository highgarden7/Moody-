rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function couplePath(coupleId) {
      return /databases/$(database)/documents/couples/$(coupleId);
    }

    function coupleData(coupleId) {
      return get(couplePath(coupleId)).data;
    }

    function isCoupleMember(coupleId) {
      return isSignedIn() && request.auth.uid in coupleData(coupleId).members;
    }

    function isCreatingOwnCouple() {
      return isSignedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.auth.uid in request.resource.data.members
        && request.resource.data.anniversary is timestamp
        && request.resource.data.createdAt is timestamp;
    }

    function isPairJoinUpdate(coupleId) {
      return isSignedIn()
        && resource.data.members is list
        && request.resource.data.members is list
        && resource.data.members.size() == 1
        && request.resource.data.members.size() == 2
        && !(request.auth.uid in resource.data.members)
        && request.auth.uid in request.resource.data.members
        && resource.data.members[0] in request.resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);
    }

    match /pairingCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.coupleId is string
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /couples/{coupleId} {
      allow create: if isCreatingOwnCouple();
      allow read, delete: if isCoupleMember(coupleId);
      allow update: if isCoupleMember(coupleId) || isPairJoinUpdate(coupleId);

      match /{doc=**} {
        allow read, write: if isSignedIn()
          && request.auth.uid in get(couplePath(coupleId)).data.members;
      }
    }
  }
}
