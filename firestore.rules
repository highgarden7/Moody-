rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function coupleDoc(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId));
    }

    function isCoupleMember(coupleId) {
      return isSignedIn()
        && request.auth.uid in coupleDoc(coupleId).data.members;
    }

    match /pairingCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.coupleId is string
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /couples/{coupleId} {
      allow read, update, delete: if isCoupleMember(coupleId);
      allow create: if isSignedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.auth.uid in request.resource.data.members
        && request.resource.data.anniversary is timestamp
        && request.resource.data.createdAt is timestamp;

      match /events/{eventId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      match /moods/{date} {
        allow read, write: if isCoupleMember(coupleId);
      }

      match /ddays/{ddayId} {
        allow read, write: if isCoupleMember(coupleId);
      }
    }
  }
}
